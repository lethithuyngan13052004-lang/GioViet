@{
    ViewData["Title"] = "Liên Hệ - Đội Ngũ Gió Việt";
}

<style>
    .contact-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #05295d 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 30px 30px;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.2);
    }
    
    .team-card {
        border: none;
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background-color: #fff;
        height: 100%;
        overflow: hidden;
    }
    
    .team-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .team-card-header {
        position: relative;
        height: 160px;
        background: linear-gradient(45deg, #f8f9fa, #e9ecef);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 20px;
    }

    .team-card-header-bg {
        position: absolute;
        top: 0; left: 0; right: 0; height: 100px;
        background: url('/images/HHT_banner_png.png') center/contain no-repeat;
        opacity: 0.3;
    }

    .member-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 5px solid #fff;
        object-fit: cover;
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        position: relative;
        z-index: 2;
        background-color: #f1f3f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #adb5bd;
        font-weight: bold;
    }

    .social-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #f8f9fa;
        color: #495057;
        transition: all 0.3s;
        margin: 0 5px;
    }

    .social-icon:hover {
        background-color: #0d6efd;
        color: #fff;
        transform: scale(1.1);
    }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .info-list li {
        padding: 10px 0;
        border-bottom: 1px dashed #e9ecef;
        display: flex;
        align-items: center;
    }

    .info-list li:last-child {
        border-bottom: none;
    }

    .info-list i {
        color: #0d6efd;
        width: 30px;
        font-size: 1.1rem;
    }

    .role-badge {
        background-color: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
        font-weight: 600;
        padding: 5px 15px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 10px;
    }
</style>

<!-- Hero Section -->
