@{
    ViewData["Title"] = "Thống Kê Tổng Quan";
    var tripCounts = ViewBag.TripStatusCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var orderCounts = ViewBag.OrderStatusCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid py-4" style="max-width: 1200px;">
    <!-- NỬA TRÊN: KHÔNG BỊ ẢNH HƯỞNG BỞI FILTER -->
    <h3 class="fw-bold mb-4 text-primary"><i class="bi bi-pie-chart-fill me-2"></i>Tổng Quan Trạng Thái (Toàn thời gian)</h3>

    <div class="row g-4 mb-4">
        <!-- Khách hàng -->
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>
                        <span class="badge bg-primary rounded-pill">Total</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Khách hàng</h6>
                    <h2 class="fw-bold mb-0 text-primary">@ViewBag.TotalCustomers.ToString("N0")</h2>
                </div>
            </div>
        </div>

        <!-- Tài xế -->
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-car-front-fill fs-4"></i>
                        </div>
                        <span class="badge bg-info rounded-pill text-dark">Total</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Tài xế</h6>
                    <h2 class="fw-bold mb-0 text-info">@ViewBag.TotalDrivers.ToString("N0")</h2>
                </div>
            </div>
        </div>

        <!-- Chuyến xe -->
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-truck-front-fill fs-4"></i>
                        </div>
                        <span class="badge bg-success rounded-pill">Total</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Chuyến xe</h6>
                    <h2 class="fw-bold mb-0 text-success">@ViewBag.TotalTrips.ToString("N0")</h2>
                </div>
            </div>
        </div>

        <!-- Đơn hàng -->
        <div class="col-xl-3 col-lg-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-warning bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-box-seam-fill fs-4"></i>
                        </div>
                        <span class="badge bg-warning rounded-pill text-dark">Total</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Đơn hàng</h6>
                    <h2 class="fw-bold mb-0 text-warning text-dark">@ViewBag.TotalOrders.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts / Breakdown Tables (Unaffected) -->
    <div class="row g-4 mb-5">
        <!-- Phân loại chuyến xe -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-list-task me-2 text-success"></i>Trạng thái Chuyến xe</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Trạng thái</th>
                                    <th class="text-end pe-4">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-warning text-dark"><i class="bi bi-clock-fill me-1"></i>Đã tạo / Chờ ghép</span></td>
                                    <td class="text-end pe-4 fw-bold">@(tripCounts.ContainsKey(1) ? tripCounts[1] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-primary"><i class="bi bi-truck me-1"></i>Đang chạy / Khoá ghép</span></td>
                                    <td class="text-end pe-4 fw-bold">@(tripCounts.ContainsKey(2) ? tripCounts[2] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Hoàn thành</span></td>
                                    <td class="text-end pe-4 fw-bold">@(tripCounts.ContainsKey(3) ? tripCounts[3] : 0)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Phân loại Đơn hàng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-bar-chart-steps me-2 text-warning"></i>Trạng thái Đơn yêu cầu</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Trạng thái</th>
                                    <th class="text-end pe-4">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-secondary"><i class="bi bi-hourglass-top me-1"></i>Chờ xử lý</span></td>
                                    <td class="text-end pe-4 fw-bold">@(orderCounts.ContainsKey(0) ? orderCounts[0] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-primary"><i class="bi bi-check me-1"></i>Đã được chấp nhận</span></td>
                                    <td class="text-end pe-4 fw-bold">@(orderCounts.ContainsKey(1) ? orderCounts[1] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-info text-dark"><i class="bi bi-truck me-1"></i>Đang giao hàng</span></td>
                                    <td class="text-end pe-4 fw-bold">@(orderCounts.ContainsKey(3) ? orderCounts[3] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Hoàn thành</span></td>
                                    <td class="text-end pe-4 fw-bold">@(orderCounts.ContainsKey(4) ? orderCounts[4] : 0)</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Bị từ chối / Hủy</span></td>
                                    <td class="text-end pe-4 fw-bold">@(orderCounts.ContainsKey(2) ? orderCounts[2] : 0)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr class="mb-5 text-muted"/>

    <!-- NỬA DƯỚI: THUỘC VỀ DOANH THU LỌC THEO THÁNG NĂM -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <h3 class="fw-bold text-danger mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Phân Tích Doanh Thu</h3>
        <form asp-action="Index" method="get" class="d-flex align-items-center bg-white px-3 py-2 rounded-pill shadow-sm border">
            <i class="bi bi-calendar-event text-muted me-2"></i>
            <label class="form-label mb-0 me-2 fw-bold text-muted text-nowrap">Từ Tháng:</label>
            <select name="startMonth" class="form-select rounded-pill form-select-sm border-primary text-primary fw-bold me-2" style="width: 70px;" onchange="this.form.submit()">
                @for(int m=1; m<=12; m++) {
                    if (ViewBag.StartMonth == m) {
                        <option value="@m" selected>@m</option>
                    } else {
                        <option value="@m">@m</option>
                    }
                }
            </select>
            
            <label class="form-label mb-0 me-2 fw-bold text-muted text-nowrap">Đến:</label>
            <select name="endMonth" class="form-select rounded-pill form-select-sm border-primary text-primary fw-bold me-3" style="width: 70px;" onchange="this.form.submit()">
                @for(int m=1; m<=12; m++) {
                    if (ViewBag.EndMonth == m) {
                        <option value="@m" selected>@m</option>
                    } else {
                        <option value="@m">@m</option>
                    }
                }
            </select>

            <label class="form-label mb-0 me-2 fw-bold text-muted text-nowrap border-start ps-3">Năm:</label>
            <select name="filterYear" class="form-select rounded-pill form-select-sm border-primary text-primary fw-bold" style="width: 90px; cursor: pointer;" onchange="this.form.submit()">
                @for (int y = DateTime.Now.Year; y >= 2023; y--)
                {
                    if (ViewBag.CurrentYear == y) {
                        <option value="@y" selected>@y</option>
                    } else {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </form>
    </div>
    
    <div class="row g-4 mb-4">
        <!-- Doanh thu tổng (Giá trị hàng vận chuyển) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-danger bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cash-coin fs-4"></i>
                        </div>
                        <span class="badge bg-danger rounded-pill">Chỉ đếm đơn thành công</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Tổng giá trị lưu thông (GMV)</h6>
                    <h2 class="fw-bold mb-0 text-danger">@ViewBag.TotalRevenue.ToString("N0") VNĐ</h2>
                </div>
            </div>
        </div>
        
        <!-- Doanh thu Platform (Phí Nền Tảng) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-wallet-fill fs-4"></i>
                        </div>
                        <span class="badge bg-dark rounded-pill">Doanh thu Web</span>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Phí Nền Tảng (Platform Fee)</h6>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalPlatformFee.ToString("N0") VNĐ</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ Thống kê -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-graph-up text-primary me-2"></i>Biểu đồ Theo Thời Gian Đã Chọn</h5>
                </div>
                <div class="card-body">
                    <div style="height: 400px; width: 100%;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Dữ liệu từ ViewBag đã được tuần tự hóa JSON
            var chartLabels = @Html.Raw(ViewBag.ChartLabels);
            var gmvData = @Html.Raw(ViewBag.GmvData);
            var feeData = @Html.Raw(ViewBag.FeeData);

            var revenueChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [
                        {
                            label: 'Tổng GMV (Lưu thông)',
                            data: gmvData,
                            backgroundColor: 'rgba(220, 53, 69, 0.6)', /* text-danger opacity */
                            borderColor: 'rgba(220, 53, 69, 1)',
                            borderWidth: 1,
                            borderRadius: 4,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Phí Nền Tảng (Thu Nhập)',
                            data: feeData,
                            type: 'line',
                            fill: true,
                            backgroundColor: 'rgba(33, 37, 41, 0.15)', /* text-dark opacity */
                            borderColor: 'rgba(33, 37, 41, 1)',
                            borderWidth: 2,
                            tension: 0.3,
                            pointBackgroundColor: 'rgba(33, 37, 41, 1)',
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'GMV (VNĐ)'
                            },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000) + ' Tr';
                                    if (value >= 1000) return (value / 1000) + ' k';
                                    return value;
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Phí Nền Tảng (VNĐ)'
                            },
                            grid: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000) + ' Tr';
                                    if (value >= 1000) return (value / 1000) + ' k';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}

<style>
    body { background-color: #f8f9fa; }
    .card { transition: transform 0.2s ease, box-shadow 0.2s ease; border: 1px solid rgba(0,0,0,0.05); }
    .card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.1)!important; }
</style>