@model TimChuyenDi.Models.Trip
@{
    ViewData["Title"] = "Đăng Chuyến Xe & Lập Lộ Trình";
}

<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<!-- Toast Container (Standard UI) -->
<div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1060; margin-top: 20px;">
    <div id="actionToast" class="toast align-items-center border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true" style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-left: 6px solid !important;">
        <div class="d-flex">
            <div class="toast-body fw-bold px-3 py-3" id="toastMessage" style="font-size: 1rem;">
                Thao tác thành công!
            </div>
            <button type="button" class="btn-close me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    #intermediateStationsContainer {
    transition: all 0.2s ease;
    will-change: opacity, transform;
    }

    #map { height: 650px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .card-trip { border: none; border-radius: 20px; overflow: hidden; }
    .form-section-title { font-weight: 700; color: #0d6efd; border-left: 4px solid #0d6efd; padding-left: 10px; margin-bottom: 20px; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .trip-type-card { cursor: pointer; border: 2px solid #f1f3f5; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); background: #fdfdfe; border-radius: 12px !important; }
    .trip-type-card:hover { border-color: #0d6efd; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(13, 110, 253, 0.08); }
    .trip-type-radio:checked + .trip-type-card { border-color: #0d6efd; background-color: #f0f7ff; box-shadow: 0 5px 15px rgba(13, 110, 253, 0.12); }
    
    .intermediate-station { display: flex; align-items: center; background: #fff; border: 1px solid #e9ecef; padding: 12px; border-radius: 12px; margin-bottom: 10px; transition: 0.2s; }
    .intermediate-station:hover { border-color: #ffc107; background: #fffcf5; }
    
    .select-highlight { animation: highlight-fade 1.5s ease-out; }
    @@keyframes highlight-fade {
        0% { background-color: rgba(13, 110, 253, 0.15); box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2); }
        100% { background-color: transparent; box-shadow: none; }
    }
    .map-popup-content { border-radius: 12px; padding: 5px; }

</style>

<div class="container-fluid py-4">
    <form asp-action="CreateTrip" method="post" id="tripForm">
        @if(TempData["PreFillReqId"] != null)
        {
            <input type="hidden" name="LinkedReqId" value="@TempData["PreFillReqId"]" />
        }
        <div class="row g-4">
            <!-- Left Panel: Form Data -->
            <div class="col-lg-4">
                <div class="card card-trip shadow-lg h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-truck me-2"></i>Thông Tin Chuyến Xe</h5>
                    </div>
                    <div class="card-body p-4 overflow-auto" style="max-height: 80vh;">
                        
                        <div class="form-section-title">1. Chọn Phương Tiện & Loại Hình</div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn xe vận tải</label>
                            <select name="VehicleId" id="vehicleSelect" class="form-select select2-bootstrap" required>
                                <option value="">-- Chọn xe của bạn --</option>
                                @foreach (var v in ViewBag.Vehicles)
                                {
                                    <option value="@v.VehicleId" data-kg="@v.CapacityKg">
                                        @v.PlateNumber (@v.VehicleType.TypeName - @v.CapacityKg kg)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Chọn loại chuyến đi</label>

                            <div class="d-flex flex-column gap-2">
                                @foreach (var type in ViewBag.TripTypes)
                                {
                                    <div>
                                        <input type="radio"
                                            name="RouteType"
                                            value="@type.IdType"
                                            id="type-@type.IdType"
                                            class="d-none trip-type-radio"
                                            required
                                            @(type.IdType == 1 ? "checked" : "")>

                                        <label for="type-@type.IdType" class="trip-type-card p-2 rounded w-100">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="fs-5">
                                                    @(type.Type == "Direct" ? "🚗" : "📦")
                                                </div>

                                                <div>
                                                    <div class="fw-bold">
                                                        @(type.Type == "Direct" ? "Chuyến riêng" : "Chuyến ghép")
                                                    </div>

                                                    <small class="text-muted">
                                                        @(type.Type == "Direct"
                                                            ? "Không ghép đơn, đi thẳng đến điểm đến"
                                                            : "Nhận thêm đơn khác trên cùng tuyến đường")
                                                    </small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-section-title">2. Lập Lộ Trình</div>

                        <!-- START STATION -->
                        <div class="p-3 bg-light rounded border border-primary border-opacity-25 mb-3">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-geo-alt-fill"></i> ĐIỂM XUẤT PHÁT</label>
                            <select id="provinceStart" class="form-select select2-bootstrap mb-2" onchange="filterStations('start')">
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                                @foreach (var p in ViewBag.Provinces)
                                {
                                    <option value="@p.ProvinceId">@p.ProvinceName</option>
                                }
                            </select>
                            <select name="FromStation" id="fromStation" class="form-select select2-stations" required disabled>
                                <option value="">-- Chọn trạm --</option>
                            </select>
                        </div>

                        <!-- INTERMEDIATE STATIONS -->
                        <div id="intermediateStationsContainer" class="mb-3" style="display: none;">
                            <label class="form-label fw-bold text-warning"><i class="bi bi-plus-circle-fill"></i> CÁC TRẠM DỪNG (PHỤ)</label>
                            <div id="stopsList">
                                <!-- Dynamic stops -->
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-warning w-100 mt-1 fw-bold rounded-pill" onclick="addStop()">
                                <i class="bi bi-plus-lg"></i> THÊM TRẠM DỪNG PHỤ
                            </button>
                        </div>

                        <!-- END STATION -->
                        <div class="p-3 bg-light rounded border border-success border-opacity-25 mb-4">
                            <label class="form-label fw-bold text-success"><i class="bi bi-flag-fill"></i> ĐIỂM ĐẾN NƠI</label>
                            <select id="provinceEnd" class="form-select select2-bootstrap mb-2" onchange="filterStations('end')">
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                                @foreach (var p in ViewBag.Provinces)
                                {
                                    <option value="@p.ProvinceId">@p.ProvinceName</option>
                                }
                            </select>
                            <select name="ToStation" id="toStation" class="form-select select2-stations" required disabled>
                                <option value="">-- Chọn trạm --</option>
                            </select>
                        </div>

                        <div class="form-section-title">3. Thời Gian & Giá Cước</div>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted">Giới hạn tải trọng: <span id="vehicleLimits" class="text-primary">Chưa chọn xe</span></label>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Trọng tải còn lại của chuyến này (kg)</label>
                                <div class="input-group">
                                    <input type="number" name="AvaiCapacityKg" id="capacityKgInput" class="form-control" required placeholder="Nhập số kg" oninput="checkCapacity()">
                                    <span class="input-group-text bg-light text-muted">kg</span>
                                </div>

                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Giá cơ bản (VNĐ)</label>
                                <input type="number" name="BasePrice" class="form-control" required placeholder="Ví dụ: 500000">
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="form-label fw-bold">Giờ xuất phát</label>
                                <input type="datetime-local" name="StartTime" id="startTime" class="form-control" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary">Ngày tới (Dự kiến)</label>
                                <input type="datetime-local" name="EstArrivalTime" id="arrivalTime" class="form-control" required>
                                <small class="text-muted" id="etaMessage"></small>
                            </div>
                        </div>

                        <input type="hidden" name="Distance" id="distanceInput">
                        <input type="hidden" name="intermediateStations" id="hiddenStops">

                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-lg rounded-pill" onclick="return validateAndSubmit()">
                            <i class="bi bi-check-circle-fill me-2"></i> XÁC NHẬN ĐĂNG CHUYẾN
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Map -->
            <div class="col-lg-8">
                <div class="card card-trip shadow-lg h-100">
                    <div class="card-body p-0 position-relative">
                        <div id="map"></div>


                        <div class="position-absolute bottom-0 start-0 p-3 w-100" style="z-index: 1000;">
                            <div class="bg-white p-3 rounded-pill shadow-lg d-flex justify-content-around align-items-center mx-auto" style="max-width: 600px;">
                                <div class="text-center px-4">
                                    <span class="d-block small text-muted">Tổng quãng đường</span>
                                    <span class="h5 fw-bold mb-0 text-primary" id="totalDistance">0 km</span>
                                </div>
                                <div class="vr"></div>
                                <div class="text-center px-4">
                                    <span class="d-block small text-muted">Thời gian di chuyển</span>
                                    <span class="h5 fw-bold mb-0 text-success" id="totalTime">0 h</span>
                                </div>
                                <div class="vr"></div>
                                 <div class="text-center px-4">
                                     <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetMap()">
                                         <i class="bi bi-arrow-repeat"></i> Reset Map
                                     </button>
                                 </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    const isCreateTripPage = true;
</script>

@section Scripts {
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
<script>if(!$.fn.select2){ document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"><\/script>'); }</script>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

<script>
    var map;
    var markers = [];
    var lastTotalTimeSeconds = 0;
    var isRoutingInProgress = false;
    var routeDebounceTimer;

    /* ============================================================
       🔥 CRITICAL: TOGGLE LISTENER (TOP PRIORITY - DO NOT MOVE)
       Placed here to ensure it binds even if other UI plugins fail.
    ============================================================ */
    $(document).on('change', 'input[name="RouteType"]', function () {
        var val = $(this).val();
        console.log("TripType Changed to:", val);
        updateIntermediateSection(val);
    });

    $(document).ready(function () {
        try {
            console.log("Initializing UI Components...");
            initMap();
        } catch(e) { console.error("Map Init Error:", e); }

        try {
            initSelect2();
        } catch(e) { console.error("Select2 Init Error:", e); }

        // Initial state check
        var initVal = $('input[name="RouteType"]:checked').val();
        if (initVal) updateIntermediateSection(initVal);

        // Vehicle Capacity Auto-fill & Limit Display
        $(document).on('change', '#vehicleSelect', function () {
            var kg = $(this).find(':selected').data('kg');
            
            if (kg) {
                $('#capacityKgInput').val(kg);
                $('#vehicleLimits').text(`Tối đa ${kg}kg`).removeClass('text-danger').addClass('text-primary');
            } else {
                $('#vehicleLimits').text('Chưa chọn xe').removeClass('text-danger');
            }
            checkCapacity();
        });

        $('#fromStation, #toStation').on('change', debounceUpdateRoute);
        $('#startTime').on('change', () => calculateArrivalTime(lastTotalTimeSeconds));

        // Date/Time restriction
        const now = new Date();
        const offset = now.getTimezoneOffset() * 60000;
        const localISOTime = (new Date(now - offset)).toISOString().slice(0, 16);
        $('#startTime').attr('min', localISOTime);
        if (!$('#startTime').val()) $('#startTime').val(localISOTime);

        // Context-Aware Map Sync for Start/End
        $('#provinceStart, #fromStation').on('select2:opening focus', function() {
            let pId = $('#provinceStart').val();
            if (pId) syncMapWithProvince(pId, 'start');
        });
        $('#provinceEnd, #toStation').on('select2:opening focus', function() {
            let pId = $('#provinceEnd').val();
            if (pId) syncMapWithProvince(pId, 'end');
        });

        // ==========================================
        // AUTO PREFILL FROM TEMPDATA (Merge/NewTrip Flow)
        // ==========================================
        @if(TempData["PreFillReqId"] != null)
        {
            <text>
            setTimeout(async function() {
                var preFromProvId = '@TempData["PreFillFromProvinceId"]';
                var preFromStId = '@TempData["PreFillFromStationId"]';
                var preToProvId = '@TempData["PreFillToProvinceId"]';
                var preToStId = '@TempData["PreFillToStationId"]';
                var preStartTime = '@TempData["PreFillStartTime"]';
                var preMsg = '@Html.Raw(TempData["PreFillMessage"])';

                if(preMsg) showToast(preMsg);

                // Set StartTime and disable
                if(preStartTime) {
                    $('#startTime').val(preStartTime).prop('readonly', true);
                }

                // Auto Select Start
                if(preFromProvId) {
                    $('#provinceStart').val(preFromProvId).trigger('change');
                    // Wait for stations to load
                    await filterStations('start');
                    setTimeout(() => {
                        $('#fromStation').val(preFromStId).trigger('change');
                        // Make them disabled to lock the route but attach hidden inputs so they submit
                        $('#provinceStart, #fromStation').prop('disabled', true);
                        $('<input>').attr({type: 'hidden', name: 'FromStation', value: preFromStId}).appendTo('form');
                    }, 500);
                }

                // Auto Select End
                if(preToProvId) {
                    $('#provinceEnd').val(preToProvId).trigger('change');
                    await filterStations('end');
                    setTimeout(() => {
                        $('#toStation').val(preToStId).trigger('change');
                        $('#provinceEnd, #toStation').prop('disabled', true);
                        $('<input>').attr({type: 'hidden', name: 'ToStation', value: preToStId}).appendTo('form');
                    }, 500);
                }
            }, 800);
            </text>
        }
    });

    async function syncMapWithProvince(pId, type) {
        if (!pId) return;
        try {
            const response = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
            const stations = await response.json();
            showProvinceMarkers(stations, type);
        } catch (e) { console.error("Sync Map Error:", e); }
    }

    /* ✅ LOGIC ẨN TRẠM PHỤ (ROBUST VERSION) */
    function updateIntermediateSection(val) {
        let container = $('#intermediateStationsContainer');
        if (!container.length) return;

        // Ensure val is compared as a string and handle whitespace
        var value = (val || "").toString().trim();

        if (value == "2") {
    container
        .css({ display: 'block', opacity: 0, transform: 'translateY(-10px)' })
        .animate({ opacity: 1 }, 200)
        .css({ transform: 'translateY(0)' });

} else {
    container.animate({ opacity: 0 }, 150, function () {
        container.css('display', 'none');
        $('#stopsList').empty();
        updateRoute();
    });
}
    }

    function initMap() {
        map = new maplibregl.Map({
            container: 'map',
            style: 'https://tiles.openfreemap.org/styles/liberty',
            center: [108.2022, 16.0544],
            zoom: 6
        });

        map.on('load', function () {
            applyMapLibreStyleFilter(map);
            addVNIslandsToMapLibre(map, maplibregl);
        });
    }

    function debounceUpdateRoute() {
        clearTimeout(routeDebounceTimer);
        routeDebounceTimer = setTimeout(updateRoute, 600);
    }

    function initSelect2() {
        if ($.fn.select2) {
            $('.select2-bootstrap').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Chọn --', allowClear: true });
            $('.select2-stations').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Tìm trạm... --', allowClear: true });
            $('.intermediate-select').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Chọn trạm phụ --', allowClear: true });

            $(document).on('select2:open', () => {
                setTimeout(() => {
                    let searchField = document.querySelector('.select2-container--open .select2-search__field');
                    if (searchField) searchField.focus();
                }, 50);
            });
            console.log("Select2 Initialized Success.");
        }
    }

    function showToast(message, isError = false) {
        var toastEl = document.getElementById('actionToast');
        var toastMsg = document.getElementById('toastMessage');
        toastMsg.innerText = message;
        
        if (isError) {
            toastEl.style.backgroundColor = 'rgba(248, 215, 218, 0.9)'; 
            toastEl.style.color = '#842029'; 
            toastEl.style.borderLeftColor = '#dc3545'; 
        } else {
            toastEl.style.backgroundColor = 'rgba(209, 231, 221, 0.9)'; 
            toastEl.style.color = '#0f5132'; 
            toastEl.style.borderLeftColor = '#198754';
        }
        // Lỗi/Cảnh báo hiện lâu hơn (4 giây)
        var duration = isError ? 4000 : 1500;
        var toast = new bootstrap.Toast(toastEl, { delay: duration });
        toast.show();
    }

    async function updateRoute() {
        markers.forEach(m => m.remove());
        markers = [];
        
        if (map.getSource('route')) {
            map.removeLayer('route');
            map.removeSource('route');
        }
        if (map.getSource('route-fallback')) {
            map.removeLayer('route-fallback');
            map.removeSource('route-fallback');
        }

        const VN_CORRIDOR = [
            { name: "Hà Tĩnh (AH1)", lat: 18.06, lng: 106.31 },
            { name: "Quảng Ngãi (AH1)", lat: 15.12, lng: 108.79 },
            { name: "Phú Yên (AH1)", lat: 13.10, lng: 109.28 },
            { name: "Ninh Thuận (AH1)", lat: 11.58, lng: 108.98 }
        ];

        const VN_REGIONS = {
            'North': ["Hà Nội", "Hải Phòng", "Hải Dương", "Hưng Yên", "Bắc Ninh", "Vĩnh Phúc", "Thái Nguyên", "Phú Thọ", "Bắc Giang", "Quảng Ninh", "Bắc Kạn", "Cao Bằng", "Hà Giang", "Lạng Sơn", "Tuyên Quang", "Lào Cai", "Yên Bái", "Điện Biên", "Hòa Bình", "Lai Châu", "Sơn La", "Hà Nam", "Nam Định", "Ninh Bình", "Thái Bình"],
            'Central': ["Thanh Hóa", "Nghệ An", "Hà Tĩnh", "Quảng Bình", "Quảng Trị", "Thừa Thiên Huế", "Đà Nẵng", "Quảng Nam", "Quảng Ngãi", "Bình Định", "Phú Yên", "Khánh Hòa", "Ninh Thuận", "Bình Thuận", "Kon Tum", "Gia Lai", "Đắk Lắk", "Đắk Nông", "Lâm Đồng"],
            'South': ["Hồ Chí Minh", "Bình Dương", "Đồng Nai", "Bình Phước", "Tây Ninh", "Bà Rịa - Vũng Tàu", "Long An", "Tiền Giang", "Bến Tre", "Trà Vinh", "Vĩnh Long", "Đồng Tháp", "An Giang", "Kiên Giang", "Cần Thơ", "Hậu Giang", "Sóc Trăng", "Bạc Liêu", "Cà Mau"]
        };

        function getRegion(provinceName) {
            if (!provinceName) return null;
            for (let region in VN_REGIONS) {
                if (VN_REGIONS[region].some(p => provinceName.includes(p) || p.includes(provinceName))) return region;
            }
            return null;
        }

        function sortRawWaypoints(start, end, stops) {
            if (stops.length <= 1) return stops;
            const vecAB = { lat: end.lat - start.lat, lng: end.lng - start.lng };
            return stops.sort((a, b) => {
                const projA = (a.lat - start.lat) * vecAB.lat + (a.lng - start.lng) * vecAB.lng;
                const projB = (b.lat - start.lat) * vecAB.lat + (b.lng - start.lng) * vecAB.lng;
                return projA - projB;
            });
        }

        var start = $('#fromStation option:selected');
        var startData = start.val() ? { type: 'start', stationId: parseInt(start.val()), lat: parseFloat(start.data('lat')), lng: parseFloat(start.data('lng')), name: start.text(), province: $('#provinceStart option:selected').text(), color: '#0d6efd' } : null;

        var end = $('#toStation option:selected');
        var endData = end.val() ? { type: 'end', stationId: parseInt(end.val()), lat: parseFloat(end.data('lat')), lng: parseFloat(end.data('lng')), name: end.text(), province: $('#provinceEnd option:selected').text(), color: '#198754' } : null;

        var intermediateStops = [];
        $('.intermediate-station').each(function () {
            var select = $(this).find('.intermediate-select');
            var opt = select.find('option:selected');
            if (opt.val()) {
                intermediateStops.push({ type: 'stop', stationId: parseInt(opt.val()), lat: parseFloat(opt.data('lat')), lng: parseFloat(opt.data('lng')), name: opt.text(), color: '#ffc107' });
            }
        });

        if (!startData && !endData) {
            $('#hiddenStops').val('');
            return;
        }

        if (startData && endData && intermediateStops.length > 0) {
            intermediateStops = sortRawWaypoints(startData, endData, intermediateStops);
        }

        var rawWaypoints = [];
        if (startData) rawWaypoints.push(startData);
        intermediateStops.forEach(s => rawWaypoints.push(s));
        if (endData) rawWaypoints.push(endData);

        var startRegion = startData ? getRegion(startData.province) : null;
        var endRegion = endData ? getRegion(endData.province) : null;
        var sameRegion = (startRegion && endRegion && startRegion === endRegion);
        var isShortCrossRegion = false;
        
        if (startRegion && endRegion && !sameRegion) {
            if ((startRegion === 'Central' && (endRegion === 'North' || endRegion === 'South')) ||
                (endRegion === 'Central' && (startRegion === 'North' || startRegion === 'South'))) {
                isShortCrossRegion = true;
            }
        }

        var finalWaypoints = [];
        var bounds = new maplibregl.LngLatBounds();
        var realIndices = [];

        for (var i = 0; i < rawWaypoints.length; i++) {
            var curr = rawWaypoints[i];
            realIndices.push(finalWaypoints.length);
            finalWaypoints.push([curr.lng, curr.lat]);
            bounds.extend([curr.lng, curr.lat]);

            const marker = new maplibregl.Marker({ color: curr.color })
                .setLngLat([curr.lng, curr.lat])
                .setPopup(new maplibregl.Popup({ offset: 25 }).setHTML(`<b>${curr.type === 'start' ? 'Bắt đầu' : curr.type === 'end' ? 'Kết thúc' : 'Trạm phụ'}</b>: ${curr.name}`))
                .addTo(map);
            markers.push(marker);

            if (i < rawWaypoints.length - 1 && !sameRegion) {
                var next = rawWaypoints[i+1];
                var latDiff = Math.abs(curr.lat - next.lat);
                var crossesWaist = (Math.min(curr.lat, next.lat) < 16.5 && Math.max(curr.lat, next.lat) > 19.5);
                
                if (latDiff > 2.5 || crossesWaist) { 
                    var minLat = Math.min(curr.lat, next.lat);
                    var maxLat = Math.max(curr.lat, next.lat);
                    var isNorthbound = (next.lat > curr.lat);
                    var applicablePoints = VN_CORRIDOR.filter(cp => cp.lat > minLat + 0.5 && cp.lat < maxLat - 0.5);
                    
                    if (isNorthbound) applicablePoints.sort((a,b) => a.lat - b.lat);
                    else applicablePoints.sort((a,b) => b.lat - a.lat);
                    
                    var maxAnchors = isShortCrossRegion ? 1 : 2;
                    if (applicablePoints.length > maxAnchors) {
                        if (maxAnchors === 1) applicablePoints = [applicablePoints[Math.floor(applicablePoints.length / 2)]];
                        else applicablePoints = [applicablePoints[0], applicablePoints[applicablePoints.length - 1]];
                    }
                    applicablePoints.forEach(cp => {
                        finalWaypoints.push([cp.lng, cp.lat]);
                    });
                }
            }
        }

        if (finalWaypoints.length >= 2) {
            const coords = finalWaypoints.map(w => w[0] + ',' + w[1]).join(';');
            try {
                const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords}?overview=full&geometries=geojson&steps=true`);
                const data = await response.json();

                if (data.code === 'Ok' && data.routes.length > 0) {
                    const route = data.routes[0];
                    map.addSource('route', {
                        'type': 'geojson',
                        'data': { 'type': 'Feature', 'properties': {}, 'geometry': route.geometry }
                    });
                    map.addLayer({
                        'id': 'route',
                        'type': 'line',
                        'source': 'route',
                        'layout': { 'line-join': 'round', 'line-cap': 'round' },
                        'paint': { 'line-color': '#0d6efd', 'line-width': 6, 'line-opacity': 0.8 }
                    });

                    lastTotalTimeSeconds = route.duration;
                    $('#totalDistance').text((route.distance / 1000).toFixed(1) + " km");
                    $('#totalTime').text((route.duration / 3600).toFixed(1) + " h");
                    $('#distanceInput').val((route.distance / 1000).toFixed(1));
                    calculateArrivalTime(route.duration);

                    // Calculate intermediate stops data
                    let startTimeStr = $('#startTime').val();
                    let startTime = startTimeStr ? new Date(startTimeStr) : new Date();
                    let stopsData = [];
                    
                    if (route.legs && route.legs.length > 0) {
                        // OSRM legs correspond to waypoints. But we added corridor anchors.
                        // We need to map back to original stations.
                        let legIdx = 0;
                        let accumulatedDistance = 0;
                        let accumulatedDuration = 0;

                        // We can use the fact that we know which finalWaypoints are actual stations (realIndices)
                        for (let i = 1; i < rawWaypoints.length - 1; i++) {
                            // Find legs between station i-1 and station i
                            let startLegIdx = 0; 
                            // This is complex because of corridor anchors.
                            // Simplified: use distance ratio for estimation like before if exact leg mapping is tricky
                            let ratio = (i / (rawWaypoints.length - 1));
                            let estArrival = new Date(startTime.getTime() + (route.duration * ratio) * 1000);
                            stopsData.push({
                                stationId: rawWaypoints[i].stationId,
                                distance: parseFloat(((route.distance / (rawWaypoints.length - 1)) / 1000).toFixed(2)),
                                estArrivalTime: estArrival.toISOString()
                            });
                        }
                    }
                    $('#hiddenStops').val(JSON.stringify(stopsData));
                }
            } catch (err) {
                console.error("Routing Error:", err);
                // Fallback line
                map.addSource('route-fallback', {
                    'type': 'geojson',
                    'data': { 'type': 'Feature', 'properties': {}, 'geometry': { 'type': 'LineString', 'coordinates': finalWaypoints } }
                });
                map.addLayer({
                    'id': 'route-fallback',
                    'type': 'line',
                    'source': 'route-fallback',
                    'layout': { 'line-join': 'round', 'line-cap': 'round' },
                    'paint': { 'line-color': '#0d6efd', 'line-width': 6, 'line-opacity': 0.6, 'line-dasharray': [2, 2] }
                });
            }
            map.fitBounds(bounds, { padding: 60 });
        }
    }

    /* ✅ LOGIC ADD STOP (Restored) */
    function addStop() {
        var stopCount = $('.intermediate-select').length + 1;
        var html = `
        <div class="intermediate-station d-flex gap-2 align-items-center" id="stopRow_${stopCount}">
    
            <div style="flex: 1;">
                <select class="form-select select2-bootstrap province-stop" onchange="loadStopStations(${stopCount})">
                    <option value="">-- Tỉnh dừng --</option>
                    @foreach (var p in ViewBag.Provinces) {
                        <option value="@p.ProvinceId">@p.ProvinceName</option>
                    }
                </select>
            </div>

            <div style="flex: 1;">
                <select class="form-select select2-stations intermediate-select" onchange="debounceUpdateRoute()" disabled>
                    <option value="">-- Trạm phụ --</option>
                </select>
            </div>

            <button type="button" class="btn btn-link text-danger p-0" onclick="removeStop(${stopCount})">
                <i class="bi bi-trash fs-5"></i>
            </button>

        </div>
        `;
        $('#stopsList').append(html);
        initSelect2();

        // Sync map for new stop
        $(`#stopRow_${stopCount} .province-stop, #stopRow_${stopCount} .intermediate-select`).on('select2:opening focus', function() {
            let pId = $(`#stopRow_${stopCount} .province-stop`).val();
            if (pId) syncMapWithProvince(pId, 'stop');
        });

        let el = $(`#stopRow_${stopCount}`);
        el.hide().slideDown(250).css('opacity', 0).animate({ opacity: 1 }, 200);
    }

    function removeStop(id) {
        $(`#stopRow_${id}`).animate({ opacity: 0, height: 0 }, 200, function () { $(this).remove(); debounceUpdateRoute(); });
    }

    async function loadStopStations(id) {
        var pId = $(`#stopRow_${id} .province-stop`).val();
        var pName = $(`#stopRow_${id} .province-stop option:selected`).text();
        var target = $(`#stopRow_${id} .intermediate-select`);
        if (!pId) return;
        target.prop('disabled', false).html('<option>Loading...</option>');
        const res = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
        const data = await res.json();
        
        if (data.length === 0) {
            showToast(`Tỉnh/ thành phố ${pName} hiện chưa có trạm nào`, true);
            target.html('<option value="">-- Không có trạm --</option>').prop('disabled', true);
            return;
        }

        let html = '<option value="">-- Chọn trạm --</option>';
        data.forEach(s => { html += `<option value="${s.id}" data-lat="${s.lat}" data-lng="${s.lng}">${s.name}</option>`; });
        target.html(html).trigger('change.select2');
        showProvinceMarkers(data, 'stop');
    }

    function calculateArrivalTime(seconds) {
        var start = $('#startTime').val();
        if (!start || !seconds) return;
        var arrival = new Date(new Date(start).getTime() + seconds * 1000);
        var formatted = arrival.getFullYear() + '-' + ('0' + (arrival.getMonth() + 1)).slice(-2) + '-' + ('0' + arrival.getDate()).slice(-2) + 'T' + ('0' + arrival.getHours()).slice(-2) + ':' + ('0' + arrival.getMinutes()).slice(-2);
        $('#arrivalTime').val(formatted);
        $('#etaMessage').html(`<i class="bi bi-lightning-auto"></i> ETA tự động cập nhật`);
    }

    async function filterStations(type) {
        var pId = type === 'start' ? $('#provinceStart').val() : $('#provinceEnd').val();
        var pName = type === 'start' ? $('#provinceStart option:selected').text() : $('#provinceEnd option:selected').text();
        var targetSelect = type === 'start' ? $('#fromStation') : $('#toStation');
        if (!pId) return;
        targetSelect.prop('disabled', false).html('<option value="">-- Đang nạp trạm... --</option>');
        try {
            const response = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
            const stations = await response.json();
            
            if (stations.length === 0) {
                showToast(`Tỉnh/ thành phố ${pName} hiện chưa có trạm nào`, true);
                targetSelect.html('<option value="">-- Không có trạm --</option>').prop('disabled', true);
                return;
            }

            let html = '<option value="">-- Chọn trạm --</option>';
            stations.forEach(s => { html += `<option value="${s.id}" data-lat="${s.lat}" data-lng="${s.lng}">${s.name}</option>`; });
            targetSelect.html(html).trigger('change.select2');
            showProvinceMarkers(stations, type);
        } catch (error) { console.error('Lỗi tải trạm:', error); }
    }

    function showProvinceMarkers(stations, type) {
        markers.forEach(m => m.remove());
        markers = [];
        var bounds = new maplibregl.LngLatBounds();
        stations.forEach(s => {
            if (s.lat && s.lng) {
                bounds.extend([s.lng, s.lat]);
                var color = (type === 'start') ? '#0d6efd' : (type === 'end') ? '#198754' : '#ffc107';
                
                var marker = new maplibregl.Marker({ color: color })
                    .setLngLat([s.lng, s.lat])
                    .setPopup(new maplibregl.Popup({ offset: 25 }).setHTML(`
                        <div class="text-center p-1">
                            <h6 class="fw-bold mb-1 text-primary">${s.name}</h6>
                            <p class="small text-muted mb-2">${s.address}<br/>
                                <span class="badge bg-light text-dark border fw-normal">${s.wardName ? s.wardName + ', ' : ''}${s.districtName ? s.districtName + ', ' : ''}${s.province}</span>
                            </p>
                            <button type='button' class='btn btn-sm btn-primary w-100 rounded-pill fw-bold shadow-sm' onclick='selectFromMap(${s.id}, "${type}", "${s.name}")'>Chọn Trạm Này</button>
                        </div>
                    `))
                    .addTo(map);
                markers.push(marker);
            }
        });
        if (!bounds.isEmpty()) { map.fitBounds(bounds, { padding: 50 }); }
    }

    function selectFromMap(id, type, stationName) {
        var targetSelect;
        if (type === 'start') targetSelect = $('#fromStation');
        else if (type === 'end') targetSelect = $('#toStation');
        else if (type === 'stop') {
            // Find the active stop row (one that's likely being edited)
            // For stops, we usually want the one that current province markers belong to
            targetSelect = $('.intermediate-select:not(:disabled)').last(); 
        }

        if (targetSelect) {
            targetSelect.val(id).trigger('change');
            map.closePopup();
            showToast(`Đã chọn trạm: ${stationName}`);
            var selectContainer = targetSelect.next('.select2-container');
            selectContainer.addClass('select-highlight');
            setTimeout(() => selectContainer.removeClass('select-highlight'), 1500);
            
            // Explicitly trigger routing update for direct map selection
            debounceUpdateRoute();
        }
    }

    function checkCapacity() {
        var vehicle = $('#vehicleSelect option:selected');
        var maxKg = vehicle.data('kg') || 0;
        var currKg = parseInt($('#capacityKgInput').val()) || 0;

        var isValid = true;
        if (currKg > maxKg) {
            isValid = false;
            $('#vehicleLimits').text(`Vượt quá tải trọng! (Tối đa ${maxKg}kg)`).removeClass('text-primary').addClass('text-danger');
        } else {
            $('#vehicleLimits').text(`Tối đa ${maxKg}kg`).removeClass('text-danger').addClass('text-primary');
        }
        return isValid;
    }

    function validateAndSubmit() {
        if (!checkCapacity()) {
            showToast("Sức chứa không được vượt quá tải trọng của xe!", true);
            return false;
        }

        // Logic check: Nếu đã có dữ liệu lộ trình (có khoảng cách/thời gian) thì giữ lại.
        // Nếu chưa có hoặc bị sai lệch số lượng, mới tạo JSON cơ bản từ các Select box.
        var currentJson = $('#hiddenStops').val();
        var selectedStops = [];
        $('.intermediate-select').each(function() { 
            var val = $(this).val();
            if (val) selectedStops.push({ stationId: parseInt(val) }); 
        });

        try {
            var isJson = currentJson && currentJson.trim().startsWith('[');
            if (!isJson) {
                // Nếu không phải JSON (trường hợp chuỗi cũ 1,2,3 hoặc trống)
                $('#hiddenStops').val(JSON.stringify(selectedStops));
            } else {
                var parsed = JSON.parse(currentJson);
                // Nếu số lượng trạm trong JSON khác số lượng trạm đang chọn -> Cập nhật lại JSON cơ bản
                if (parsed.length !== selectedStops.length) {
                    $('#hiddenStops').val(JSON.stringify(selectedStops));
                }
            }
        } catch (e) {
            console.error("JSON parsing error: ", e);
            $('#hiddenStops').val(JSON.stringify(selectedStops));
        }

        if (!$('#fromStation').val() || !$('#toStation').val()) { 
            showToast("Vui lòng chọn trạm đi và trạm đến!", true);
            return false; 
        }

        var form = document.getElementById('tripForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return false;
        }

        // Chống thao tác click quá nhanh (spam submit) dẫn đến duplicate database record
        var submitBtn = $('button[type="submit"]');
        submitBtn.html('<span class="spinner-border spinner-border-sm align-middle me-2"></span><span class="align-middle">ĐANG XỬ LÝ...</span>');
        setTimeout(() => { submitBtn.prop('disabled', true); }, 50);

        // Form hợp lệ, return true để cho phép form submit native
        return true;
    }

    function resetMap() { 
        markers.forEach(m => m.remove());
        markers = [];
        if (map.getSource('route')) {
            map.removeLayer('route');
            map.removeSource('route');
        }
        map.flyTo({ center: [108.2022, 16.0544], zoom: 6 });
    }

    // DỒNG BỘ FORM TỪ CHATBOT (REAL-TIME)
    let lastChatSessionStr = "";
    setInterval(function() {
        $.get('/Chat/GetDriverSessionData', function(data) {
            if (!data || !data.isActive) return;
            const currentStr = JSON.stringify(data);
            if (currentStr === lastChatSessionStr) return;
            lastChatSessionStr = currentStr;

            // Sync Vehicle
            syncField('#vehicleSelect', data.vehicleId);
            
            // Sync RouteType (Radio)
            if (data.routeType && $('input[name="RouteType"]:checked').val() != data.routeType) {
                $('#type-' + data.routeType).prop('checked', true).trigger('change');
                highlightField($('input[name="RouteType"]').parent());
                showToast('Đã cập nhật thông tin Hình thức chạy từ Trợ Gió', false);
            }

            // Sync StartTime
            syncField('#startTime', data.startTime);

            // Sync BasePrice
            syncField('input[name="BasePrice"]', data.basePrice);

            // Sync Capacity
            syncField('#capacityKgInput', data.avaiCapacityKg);

            // Sync Location
            if (data.fromProvinceId) {
                let pStart = $('#provinceStart');
                if (pStart.val() != data.fromProvinceId) {
                    pStart.val(data.fromProvinceId).trigger('change');
                    setTimeout(() => {
                        if (data.fromStationId && $('#fromStation').val() != data.fromStationId) {
                            $('#fromStation').val(data.fromStationId).trigger('change');
                            highlightField($('#fromStation'));
                        }
                    }, 1000);
                } else if (data.fromStationId) {
                    syncField('#fromStation', data.fromStationId);
                }
            }

            if (data.toProvinceId) {
                let pEnd = $('#provinceEnd');
                if (pEnd.val() != data.toProvinceId) {
                    pEnd.val(data.toProvinceId).trigger('change');
                    setTimeout(() => {
                        if (data.toStationId && $('#toStation').val() != data.toStationId) {
                            $('#toStation').val(data.toStationId).trigger('change');
                            highlightField($('#toStation'));
                        }
                    }, 1000);
                } else if (data.toStationId) {
                    syncField('#toStation', data.toStationId);
                }
            }
        });
    }, 2000);

    function syncField(selector, val) {
        if (val !== null && val !== undefined) {
            let el = $(selector);
            if (el.val() != val) {
                el.val(val).trigger('change');
                highlightField(el);
                
                // Lấy tên nhãn để hiển thị
                let label = el.closest('div').find('label').first().text().replace('*', '').trim();
                if (!label) label = "Trường dữ liệu";
                showToast('Đã cập nhật ' + label + ' từ Trợ Gió', false);
            }
        }
    }

    function highlightField(el) {
        el.addClass('bg-warning-subtle transition-all').css('transition', 'all 0.5s');
        setTimeout(() => el.removeClass('bg-warning-subtle'), 2000);
    }

    // ĐỒNG BỘ TỪ FORM NGƯỢC LẠI CHATBOT
    let syncTimeout;
    $('#tripForm input, #tripForm select').on('change input', function() {
        if (!lastChatSessionStr) return; // Nếu chatbot chưa load session thì bỏ qua
        
        clearTimeout(syncTimeout);
        syncTimeout = setTimeout(() => {
            const updateData = {
                VehicleId: $('#vehicleSelect').val() ? parseInt($('#vehicleSelect').val()) : null,
                RouteType: parseInt($('input[name="RouteType"]:checked').val()),
                AvaiCapacityKg: $('#capacityKgInput').val() ? parseInt($('#capacityKgInput').val()) : null,
                BasePrice: $('input[name="BasePrice"]').val() ? parseFloat($('input[name="BasePrice"]').val()) : null,
                StartTime: $('#startTime').val() || null,
                FromStationId: $('#fromStation').val() ? parseInt($('#fromStation').val()) : null,
                ToStationId: $('#toStation').val() ? parseInt($('#toStation').val()) : null
            };

            $.ajax({
                url: '/Chat/SyncFormToChatbot',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(updateData),
                success: function() {
                    console.log("Đã đồng bộ Form lên Chatbot", updateData);
                }
            });
        }, 1000); // Đợi gõ phím xong 1s mới đồng bộ
    });

    $(document).ready(function() {
        @if(TempData["PreFillReqId"] != null)
        {
            <text>
            setTimeout(function() {
                if ($('#aiChatBox').length && $('#aiChatBox').hasClass('d-none')) {
                    toggleAIChat();
                }
                $("#aiUserInput").val("Tiếp tục thông tin tạo chuyến mới");
                $("#aiChatForm").submit();
            }, 1000);
            </text>
        }
    });
</script>
