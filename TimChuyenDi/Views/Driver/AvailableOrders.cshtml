@model IEnumerable<TimChuyenDi.Models.Shiprequest>
@{
    ViewData["Title"] = "Tìm Đơn Hàng Phù Hợp";
    var activeTrips = ViewBag.ActiveTrips as IEnumerable<TimChuyenDi.Models.Trip>;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="fw-bold text-primary mb-0"><i class="bi bi-search me-2"></i>Chợ Đơn Hàng</h2>
                <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count() đơn hàng khả dụng</span>
            </div>
            <p class="text-muted mt-2">Dưới đây là các đơn hàng chưa có chuyến xe, có lộ trình khớp với các chuyến xe sắp tới của bạn.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 text-center">
            <i class="bi bi-info-circle fs-2 d-block mb-3"></i>
            <h5 class="fw-bold">@ViewBag.Message</h5>
            <a asp-action="CreateTrip" class="btn btn-primary mt-3 px-4 rounded-pill">Đăng chuyến xe mới</a>
        </div>
    }
    else if (!Model.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center text-center p-5 bg-light rounded-4 shadow-sm">
            <i class="bi bi-inbox text-secondary mb-3" style="font-size: 3rem;"></i>
        
            <h5 class="fw-bold mb-2">Hiện tại chưa có đơn hàng chờ nào</h5>
        
            <p class="text-muted mb-3">
                Bạn có thể quay lại sau.
            </p>

            <a href="/" class="btn btn-outline-primary rounded-pill px-4">
                Quay về trang chủ
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var route = item.Shippingroutes.FirstOrDefault();
                var cargo = item.Cargodetails.FirstOrDefault();
                
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden order-card">
                        <div class="card-header bg-white border-0 p-3 pt-4 d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-light text-primary border border-primary-subtle rounded-pill mb-2">#@(item.OrderCode ?? ("MD" + item.Id))</span>
                                <div class="text-muted small">
                                    <i class="bi bi-clock me-1"></i> Đã đăng: @item.CreatedAt.ToString("dd/MM HH:mm")
                                    <br />
                                    <i class="bi bi-truck me-1"></i> Vận chuyển: @item.PickupTimeFrom.ToString("dd/MM/yyyy") @(item.PickupTimeTo.HasValue ? " - " + item.PickupTimeTo.Value.ToString("dd/MM/yyyy") : "")
                                </div>

                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-danger fs-5">@(item.PickupTimeTo?.ToString("dd/MM/yyyy") ?? "Giao ngay")</div>
                                <div class="small text-muted text-uppercase tracking-wider">Hạn giao dự kiến</div>
                            </div>
                        </div>
                        
                        <div class="card-body p-4">
                            <!-- ROUTE DISPLAY -->
                            <div class="route-container mb-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="route-dot bg-success"></div>
                                    <div class="ms-3">
                                        <div class="text-muted small">Điểm lấy hàng</div>
                                        <div class="fw-bold">@(string.IsNullOrEmpty(route?.PickupAddress) ? (route?.FromStation?.StationName ?? "Chưa xác định") : route.PickupAddress)</div>

                                    </div>
                                </div>
                                <div class="route-line mx-2"></div>
                                <div class="d-flex align-items-center mt-3">
                                    <div class="route-dot bg-danger"></div>
                                    <div class="ms-3">
                                        <div class="text-muted small">Điểm giao hàng</div>
                                        <div class="fw-bold">@(string.IsNullOrEmpty(route?.DeliveryAddress) ? (route?.ToStation?.StationName ?? "Chưa xác định") : route.DeliveryAddress)</div>

                                    </div>
                                </div>
                            </div>

                            <hr class="my-4 opacity-10">

                            <!-- DETAILS -->
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-info-subtle text-info rounded-3 p-2 me-3">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">Hàng hóa</div>
                                            <div class="fw-bold">@(cargo?.Weight ?? 0) kg</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-warning-subtle text-warning rounded-3 p-2 me-3">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div>
                                            <div class="small text-muted">Người gửi</div>
                                            <div class="fw-bold">@item.User.Name</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <div class="mt-4 p-3 bg-light rounded-3 small text-muted">
                                    <i class="bi bi-info-circle me-1"></i> <strong>Ghi chú:</strong> @item.Note
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-0 p-4 pt-0">
                            <!-- Button trigger modal -->
                            <button type="button" class="btn btn-primary w-100 rounded-pill py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#orderModal-@item.Id">
                                <i class="bi bi-check2-circle me-2"></i>Nhận đơn ngay
                            </button>
                        </div>
                    </div>

                    <!-- Modal moved outside .order-card to prevent transform flickering -->
                    <div class="modal fade" id="orderModal-@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-lg rounded-4">
                                <div class="modal-header border-bottom-0 pb-0">
                                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-question-circle me-2"></i>Tùy chọn nhận đơn</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted mb-4">Bạn muốn xử lý đơn hàng #@(item.OrderCode ?? ("MD" + item.Id)) như thế nào?</p>
                                    
                                    <!-- Option 1: Create New Trip -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-2">Tạo chuyến đi mới</h6>
                                        <p class="small text-muted mb-2">Hệ thống sẽ tự động tìm kiếm khoảng thời gian trống theo hạn nhận hàng để chuẩn bị chuyên đi mới cho bạn.</p>
                                        <a asp-action="PreCreateNewTrip" asp-route-reqId="@item.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                                            <i class="bi bi-plus-circle me-2"></i>Tạo chuyến mới
                                        </a>
                                    </div>
                                    
                                    <hr class="text-muted opacity-25">
                                    
                                    <!-- Option 2: Merge -> Dropdown -->
                                    <div class="mt-4">
                                        <h6 class="fw-bold mb-2">Ghép vào chuyến xe có sẵn</h6>
                                        <p class="small text-muted mb-2">Thiết lập tự động chèn trạm lấy hàng và giao hàng vào lịch trình của chuyến bạn chọn.</p>
                                        @if(activeTrips.Any())
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-outline-success w-100 rounded-pill fw-bold dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-diagram-3 me-2"></i>Chọn chuyến xe...
                                                </button>
                                                <ul class="dropdown-menu shadow-lg border-0 rounded-3 w-100 p-2" style="max-height: 300px; overflow-y: auto;">
                                                    @foreach (var trip in activeTrips)
                                                    {
                                                        <li>
                                                            <a class="dropdown-item rounded-2 py-2 mb-1" asp-action="MergeToExistingTrip" asp-route-reqId="@item.Id" asp-route-tripId="@trip.TripId">
                                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                                    <span class="fw-bold">@trip.FromStationNavigation.Province.ProvinceName <i class="bi bi-arrow-right mx-1"></i> @trip.ToStationNavigation.Province.ProvinceName</span>
                                                                    <span class="badge @(trip.Status == 0 ? "bg-warning text-dark" : "bg-primary")">@(trip.Status == 0 ? "Chờ" : "Đang chạy")</span>
                                                                </div>
                                                                <div class="small text-muted">
                                                                    <i class="bi bi-clock me-1"></i> Bắt đầu: @trip.StartTime.ToString("dd/MM HH:mm")
                                                                </div>
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning p-2 small mb-0">Bạn hiện không có chuyến xe nào đang hoạt động.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .order-card {
        transition: transform 0.3s ease, shadow 0.3s ease;
    }
    .order-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
    }
    .route-container {
        position: relative;
    }
    .route-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        z-index: 2;
    }
    .route-line {
        position: absolute;
        top: 24px;
        left: 5px;
        bottom: 24px;
        width: 2px;
        background: repeating-linear-gradient(to bottom, #dee2e6 0, #dee2e6 5px, transparent 5px, transparent 10px);
        z-index: 1;
    }
    .icon-box {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .tracking-wider {
        letter-spacing: 0.05em;
    }
</style>
