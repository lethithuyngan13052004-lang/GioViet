@model TimChuyenDi.Models.Trip
@{
    ViewData["Title"] = "Chi tiết Chuyến Xe & Lộ Trình";
    var stopCounter = 1; 
    var isStarted = Model.Status >= 1; // InProgress or Completed
    var isCompleted = Model.Status == 2;
    
    string statusBadgeClass = Model.Status switch {
        0 => "bg-warning text-dark",
        1 => "bg-primary",
        2 => "bg-success",
        _ => "bg-secondary"
    };
}

<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<!-- Toast Container (Standard UI) -->
<div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1060; margin-top: 20px;">
    <div id="actionToast" class="toast align-items-center border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true" style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-left: 6px solid !important;">
        <div class="d-flex">
            <div class="toast-body fw-bold px-3 py-3" id="toastMessage" style="font-size: 1rem;">
                Thao tác thành công!
            </div>
            <button type="button" class="btn-close me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    #intermediateStationsContainer { transition: all 0.2s ease; will-change: opacity, transform; }
    #map { height: 650px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .card-trip { border: none; border-radius: 20px; overflow: hidden; }
    .form-section-title { font-weight: 700; color: #36b9cc; border-left: 4px solid #36b9cc; padding-left: 10px; margin-bottom: 20px; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .trip-type-card { cursor: pointer; border: 2px solid #f1f3f5; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); background: #fdfdfe; border-radius: 12px !important; }
    .trip-type-card:hover { border-color: #36b9cc; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(54, 185, 204, 0.08); }
    .trip-type-radio:checked + .trip-type-card { border-color: #36b9cc; background-color: #f0fbfc; box-shadow: 0 5px 15px rgba(54, 185, 204, 0.12); }
    
    .intermediate-station { display: flex; align-items: center; background: #fff; border: 1px solid #e9ecef; padding: 12px; border-radius: 12px; margin-bottom: 10px; transition: 0.2s; }
    .intermediate-station:hover { border-color: #ffc107; background: #fffcf5; }
    .select-highlight { animation: highlight-fade 1.5s ease-out; }
    @@keyframes highlight-fade {
        0% { background-color: rgba(54, 185, 204, 0.15); box-shadow: 0 0 0 3px rgba(54, 185, 204, 0.2); }
        100% { background-color: transparent; box-shadow: none; }
    }
</style>

<div class="container-fluid py-4">
    <form asp-action="EditTrip" method="post" id="tripForm">
        <input type="hidden" name="TripId" value="@Model.TripId" />
        <div class="row g-4">
            <!-- Left Panel: Form Data -->
            <div class="col-lg-4">
                <div class="card card-trip shadow-lg h-100">
                    <div class="card-header p-4 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #36b9cc, #4e73df);">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Chi Tiết #CX-@Model.TripId</h5>
                    </div>
                    <div class="card-body p-4 overflow-auto" style="max-height: 80vh;">
                        
                        <div class="form-section-title">1. Phương Tiện & Loại Hình</div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Xe vận tải</label>
                            @if (isStarted) { <input type="hidden" name="VehicleId" value="@Model.VehicleId" /> }
                            <select name="VehicleId" id="vehicleSelect" class="form-select select2-bootstrap" required @(isStarted ? "disabled" : "")>
                                @foreach (var v in (List<Vehicle>)ViewBag.Vehicles)
                                {
                                    <option value="@v.VehicleId" 
                                            data-kg="@v.CapacityKg" 
                                            selected="@(v.VehicleId == Model.VehicleId)">
                                        @v.PlateNumber (@v.VehicleType.TypeName - @v.CapacityKg kg)
                                    </option>
                                }
                            </select>
                            @if (isStarted) { <small class="text-muted"><i class="bi bi-lock-fill"></i> Không thể đổi xe khi đã khởi hành</small> }
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Loại hình di chuyển</label>
                            @if (isStarted) { <input type="hidden" name="RouteType" value="@Model.RouteType" /> }
                            <div class="d-flex flex-column gap-2">
                                @foreach (var type in (List<TripType>)ViewBag.TripTypes)
                                {
                                    <div>
                                        <input type="radio" name="@(isStarted ? "RouteType_Display" : "RouteType")" value="@type.IdType" id="type-@type.IdType" class="d-none trip-type-radio" required @(type.IdType == Model.RouteType ? "checked" : "") @(isStarted ? "disabled" : "")>
                                        <label for="type-@type.IdType" class="trip-type-card p-2 rounded w-100 @(isStarted && type.IdType != Model.RouteType ? "opacity-50" : "")">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="fs-5">@(type.Type == "Direct" ? "🚗" : "📦")</div>
                                                <div>
                                                    <div class="fw-bold">@(type.Type == "Direct" ? "Chuyến riêng" : "Chuyến ghép")</div>
                                                    <small class="text-muted">@(type.Type == "Direct" ? "Không ghép đơn" : "Nhận thêm đơn khách")</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-section-title">2. Lộ Trình Hiện Tại</div>

                        <!-- START STATION -->
                        <div class="p-3 bg-light rounded border border-primary border-opacity-25 mb-3">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-geo-alt-fill"></i> ĐIỂM XUẤT PHÁT</label>
                            @if (isStarted) { <input type="hidden" name="FromStation" value="@Model.FromStation" /> }
                            <select id="provinceStart" class="form-select select2-bootstrap mb-2" onchange="filterStations('start')" @(isStarted ? "disabled" : "")>
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                                @foreach (var p in (List<Province>)ViewBag.Provinces)
                                {
                                    <option value="@p.ProvinceId" selected="@(p.ProvinceId == Model.FromStationNavigation.ProvinceId)">@p.ProvinceName</option>
                                }
                            </select>
                            <input type="hidden" id="initFromStation" value="@Model.FromStation" />
                            <select name="@(isStarted ? "FromStation_Display" : "FromStation")" id="fromStation" class="form-select select2-stations" required @(isStarted ? "disabled" : "")>
                                <option value="@Model.FromStation" 
                                        data-lat="@(Model.FromStationNavigation.Latitude?.ToString()?.Replace(',', '.'))" 
                                        data-lng="@(Model.FromStationNavigation.Longitude?.ToString()?.Replace(',', '.'))" selected>
                                    @Model.FromStationNavigation.StationName
                                </option>
                            </select>
                        </div>

                        <!-- INTERMEDIATE STATIONS -->
                        <div id="intermediateStationsContainer" class="mb-3" style="display: @(Model.RouteType == 2 ? "block" : "none");">
                            <label class="form-label fw-bold text-warning"><i class="bi bi-plus-circle-fill"></i> CÁC TRẠM DỪNG (PHỤ)</label>
                            <div id="stopsList">
                                @if (Model?.TripStations != null)
                                {
                                    foreach (var ts in Model.TripStations.OrderBy(x => x.StopOrder))
                                    {
                                        if (ts?.Station != null)
                                        {
                                            <div class="intermediate-station d-flex gap-2 align-items-center" id="stopRow_@stopCounter">
                                                <div style="flex: 1;">
                                                    <select class="form-select select2-bootstrap province-stop" onchange="loadStopStations(@stopCounter)" @(isCompleted ? "disabled" : "")>
                                                        @foreach (var p in (List<Province>)ViewBag.Provinces)
                                                        {
                                                            <option value="@p.ProvinceId" selected="@(p.ProvinceId == ts.Station.ProvinceId)">@p.ProvinceName</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div style="flex: 1;">
                                                    <select class="form-select select2-stations intermediate-select" onchange="updateRoute()" @(isCompleted ? "disabled" : "")>
                                                        <option value="@ts.StationId" data-lat="@(ts.Station?.Latitude?.ToString()?.Replace(',', '.'))" data-lng="@(ts.Station?.Longitude?.ToString()?.Replace(',', '.'))" selected>@(ts.Station?.StationName)</option>
                                                    </select>
                                                </div>
                                                @if (!isCompleted) {
                                                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeStop(@stopCounter)"><i class="bi bi-trash fs-5"></i></button>
                                                }
                                            </div>
                                            stopCounter++;
                                        }
                                    }
                                }
                            </div>
                            @if (!isCompleted) {
                                <button type="button" class="btn btn-sm btn-outline-warning w-100 mt-1 fw-bold rounded-pill" onclick="addStop()">
                                    <i class="bi bi-plus-lg"></i> THÊM TRẠM DỪNG PHỤ
                                </button>
                            }
                        </div>

                        <!-- END STATION -->
                        <div class="p-3 bg-light rounded border border-success border-opacity-25 mb-4">
                            <label class="form-label fw-bold text-success"><i class="bi bi-flag-fill"></i> ĐIỂM ĐẾN NƠI</label>
                            @if (isStarted) { <input type="hidden" name="ToStation" value="@Model.ToStation" /> }
                            <select id="provinceEnd" class="form-select select2-bootstrap mb-2" onchange="filterStations('end')" @(isStarted ? "disabled" : "")>
                                <option value="">-- Chọn Tỉnh/Thành --</option>
                                @foreach (var p in (List<Province>)ViewBag.Provinces)
                                {
                                    <option value="@p.ProvinceId" selected="@(p.ProvinceId == Model.ToStationNavigation.ProvinceId)">@p.ProvinceName</option>
                                }
                            </select>
                            <input type="hidden" id="initToStation" value="@Model.ToStation" />
                            <select name="@(isStarted ? "ToStation_Display" : "ToStation")" id="toStation" class="form-select select2-stations" required @(isStarted ? "disabled" : "")>
                                <option value="@Model.ToStation" 
                                        data-lat="@(Model.ToStationNavigation.Latitude?.ToString()?.Replace(',', '.'))" 
                                        data-lng="@(Model.ToStationNavigation.Longitude?.ToString()?.Replace(',', '.'))" selected>
                                    @Model.ToStationNavigation.StationName
                                </option>
                            </select>
                        </div>

                        <div class="form-section-title">3. Tải Trọng & Giá</div>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">Trọng tải hiện tại của chuyến (kg)</label>
                                <input type="number" name="AvaiCapacityKg" id="capacityKgInput" class="form-control" value="@Model.AvaiCapacityKg" required oninput="checkCapacity()" @(isCompleted ? "readonly" : "")>
                                <small id="vehicleLimits" class="text-primary fw-bold">Tối đa @Model.Vehicle?.CapacityKg kg</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Giá cơ bản (VNĐ)</label>
                                <input type="number" name="BasePrice" class="form-control" value="@((long)Model.BasePrice)" required @(isCompleted ? "readonly" : "")>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Giờ xuất phát</label>
                                <input type="datetime-local" name="StartTime" id="startTime" class="form-control" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" required @(isStarted ? "readonly" : "")>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Giờ đến (Dự kiến)</label>
                                <input type="datetime-local" name="EstArrivalTime" id="arrivalTime" class="form-control" value="@(Model.EstArrivalTime?.ToString("yyyy-MM-ddTHH:mm"))" required>
                            </div>
                        </div>

                        <input type="hidden" name="Distance" id="distanceInput" value="@Model.Distance">
                        <input type="hidden" name="intermediateStations" id="hiddenStops">

                        <div class="d-grid gap-2">
                            @if (!isCompleted) {
                                <button type="submit" class="btn btn-primary py-3 fw-bold shadow-lg rounded-pill" onclick="return validateAndSubmit()">
                                    <i class="bi bi-save-fill me-2"></i> CẬP NHẬT CHUYẾN XE
                                </button>
                            }
                            <a asp-action="MyTrips" class="btn btn-outline-secondary rounded-pill py-2 fw-bold">
                                ← Quay về
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Map -->
            <div class="col-lg-8">
                <div class="card card-trip shadow-lg h-100">
                    <div class="card-body p-0 position-relative">
                        <div id="map"></div>
                        

                        <div class="position-absolute bottom-0 start-0 p-3 w-100" style="z-index: 1000;">
                            <div class="bg-white p-3 rounded-pill shadow-lg d-flex justify-content-around align-items-center mx-auto" style="max-width: 600px;">
                                <div class="text-center px-4">
                                    <span class="d-block small text-muted">Quãng đường</span>
                                    <span class="h5 fw-bold mb-0 text-primary" id="totalDistance">@Model.Distance km</span>
                                </div>
                                <div class="vr"></div>
                                <div class="text-center px-4">
                                    <span class="d-block small text-muted">Thời gian di chuyển</span>
                                    @{
                                        var initialTotalTime = Model.EstArrivalTime.HasValue ? (Model.EstArrivalTime.Value - Model.StartTime).TotalHours : 0;
                                        string timeDisplay = initialTotalTime > 0 ? initialTotalTime.ToString("F1") : "--";
                                    }
                                    <span class="h5 fw-bold mb-0 text-success" id="totalTime">@timeDisplay h</span>
                                </div>
                                <div class="vr"></div>
                                <div class="text-center px-4">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetMap()">
                                        <i class="bi bi-arrow-repeat"></i> Reset Map
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

<script>
    var map;
    var markers = [];
    var lastTotalTimeSeconds = 0;
    var isRoutingInProgress = false;
    var routeDebounceTimer;
    var isInitialRoute = true;

    const COLORS = {
        start: '#0d6efd',
        end: '#dc3545',
        stop: '#ffc107'
    };

    function resetMap() {
        if (initialRawData.start.lat && initialRawData.end.lat) {
            updateRouteWithData(initialRawData);
        } else {
            updateRoute();
        }
        showToast("Đã đặt lại bản đồ");
    }

    // Direct Data Injection from Server
    const initialRawData = {
        start: { 
            id: '@(Model.FromStation)', 
            lat: parseFloat('@(Model.FromStationNavigation?.Latitude?.ToString()?.Replace(",", "."))'), 
            lng: parseFloat('@(Model.FromStationNavigation?.Longitude?.ToString()?.Replace(",", "."))'), 
            name: '@Html.Raw(Model.FromStationNavigation?.StationName?.Replace("'", "\\'"))' 
        },
        end: { 
            id: '@(Model.ToStation)', 
            lat: parseFloat('@(Model.ToStationNavigation?.Latitude?.ToString()?.Replace(",", "."))'), 
            lng: parseFloat('@(Model.ToStationNavigation?.Longitude?.ToString()?.Replace(",", "."))'), 
            name: '@Html.Raw(Model.ToStationNavigation?.StationName?.Replace("'", "\\'"))' 
        },
        stops: [
            @if (Model.TripStations != null) {
                foreach (var ts in Model.TripStations.OrderBy(x => x.StopOrder)) {
                    if (ts?.Station != null) {
                        <text>{ 
                            id: '@ts.StationId', 
                            lat: parseFloat('@(ts.Station.Latitude?.ToString()?.Replace(",", "."))'), 
                            lng: parseFloat('@(ts.Station.Longitude?.ToString()?.Replace(",", "."))'), 
                            name: '@Html.Raw(ts.Station.StationName?.Replace("'", "\\'"))' 
                        },</text>
                    }
                }
            }
        ]
    };

    $(document).ready(function () {
        initMap();
        initSelect2();

        // Type Change Listener
        $('input[name="RouteType"]').change(function() {
            var val = $(this).val();
            if (val == "2") {
                $('#intermediateStationsContainer').slideDown();
                setTimeout(updateRoute, 300);
            }
            else { 
                $('#intermediateStationsContainer').slideUp(); 
                $('#stopsList').empty(); 
                updateRoute(); 
            }
        });

        // Vehicle Capacity Auto-fill
        $(document).on('change', '#vehicleSelect', function () {
            var kg = $(this).find(':selected').data('kg');
            if (kg) $('#vehicleLimits').text(`Tối đa ${kg}kg`).removeClass('text-danger').addClass('text-primary');
            else $('#vehicleLimits').text('Chưa chọn xe').removeClass('text-danger');
            checkCapacity();
        });

        $('#fromStation, #toStation').on('change', updateRoute);
        $('#startTime').on('change', () => calculateArrivalTime(lastTotalTimeSeconds));

        // Initial Route Trigger
        setTimeout(() => {
            if (initialRawData.start.lat && initialRawData.end.lat) {
                updateRouteWithData(initialRawData);
            } else {
                updateRoute();
            }
        }, 500);
    });

    function updateRouteWithData(data) {
        var rawWaypoints = [];
        rawWaypoints.push({ type: 'start', stationId: data.start.id, lat: data.start.lat, lng: data.start.lng, name: data.start.name, color: '#0d6efd' });
        data.stops.forEach(s => {
            rawWaypoints.push({ type: 'stop', stationId: s.id, lat: s.lat, lng: s.lng, name: s.name, color: '#ffc107' });
        });
        rawWaypoints.push({ type: 'end', stationId: data.end.id, lat: data.end.lat, lng: data.end.lng, name: data.end.name, color: '#dc3545' });

        drawRoute(rawWaypoints);
    }

    function initMap() {
        map = new maplibregl.Map({
            container: 'map',
            style: 'https://tiles.openfreemap.org/styles/liberty',
            center: [108.2022, 16.0544],
            zoom: 6
        });

        map.on('load', function () {
            applyMapLibreStyleFilter(map);
            addVNIslandsToMapLibre(map, maplibregl);
        });
    }
    const VN_CORRIDOR = [
        { name: "Hà Tĩnh (AH1)", lat: 18.06, lng: 106.31 },
        { name: "Quảng Ngãi (AH1)", lat: 15.12, lng: 108.79 },
        { name: "Phú Yên (AH1)", lat: 13.10, lng: 109.28 },
        { name: "Ninh Thuận (AH1)", lat: 11.58, lng: 108.98 }
    ];

    const VN_REGIONS = {
        'North': ["Hà Nội", "Hải Phòng", "Hải Dương", "Hưng Yên", "Bắc Ninh", "Vĩnh Phúc", "Thái Nguyên", "Phú Thọ", "Bắc Giang", "Quảng Ninh", "Bắc Kạn", "Cao Bằng", "Hà Giang", "Lạng Sơn", "Tuyên Quang", "Lào Cai", "Yên Bái", "Điện Biên", "Hòa Bình", "Lai Châu", "Sơn La", "Hà Nam", "Nam Định", "Ninh Bình", "Thái Bình"],
        'Central': ["Thanh Hóa", "Nghệ An", "Hà Tĩnh", "Quảng Bình", "Quảng Trị", "Thừa Thiên Huế", "Đà Nẵng", "Quảng Nam", "Quảng Ngãi", "Bình Định", "Phú Yên", "Khánh Hòa", "Ninh Thuận", "Bình Thuận", "Kon Tum", "Gia Lai", "Đắk Lắk", "Đắk Nông", "Lâm Đồng"],
        'South': ["Hồ Chí Minh", "Bình Dương", "Đồng Nai", "Bình Phước", "Tây Ninh", "Bà Rịa - Vũng Tàu", "Long An", "Tiền Giang", "Bến Tre", "Trà Vinh", "Vĩnh Long", "Đồng Tháp", "An Giang", "Kiên Giang", "Cần Thơ", "Hậu Giang", "Sóc Trăng", "Bạc Liêu", "Cà Mau"]
    };

    function getRegion(provinceName) {
        if (!provinceName) return null;
        for (let region in VN_REGIONS) {
            if (VN_REGIONS[region].some(p => provinceName.includes(p) || p.includes(provinceName))) return region;
        }
        return null;
    }


    function showToast(message, isError = false) {
        var toastEl = document.getElementById('actionToast');
        var toastMsg = document.getElementById('toastMessage');
        toastMsg.innerText = message;
        if (isError) {
            toastEl.style.borderLeftColor = '#dc3545';
        } else {
            toastEl.style.borderLeftColor = '#36b9cc';
        }
        var toast = new bootstrap.Toast(toastEl, { delay: isError ? 4000 : 2000 });
        toast.show();
    }

    async function drawRoute(rawWaypoints) {
        markers.forEach(m => m.remove());
        markers = [];
        
        if (map.getSource('route')) {
            map.removeLayer('route');
            map.removeSource('route');
        }
        if (map.getSource('route-fallback')) {
            map.removeLayer('route-fallback');
            map.removeSource('route-fallback');
        }

        const VN_CORRIDOR = [
            { name: "Hà Tĩnh (AH1)", lat: 18.06, lng: 106.31 },
            { name: "Quảng Ngãi (AH1)", lat: 15.12, lng: 108.79 },
            { name: "Phú Yên (AH1)", lat: 13.10, lng: 109.28 },
            { name: "Ninh Thuận (AH1)", lat: 11.58, lng: 108.98 }
        ];

        const VN_REGIONS = {
            'North': ["Hà Nội", "Hải Phòng", "Hải Dương", "Hưng Yên", "Bắc Ninh", "Vĩnh Phúc", "Thái Nguyên", "Phú Thọ", "Bắc Giang", "Quảng Ninh", "Bắc Kạn", "Cao Bằng", "Hà Giang", "Lạng Sơn", "Tuyên Quang", "Lào Cai", "Yên Bái", "Điện Biên", "Hòa Bình", "Lai Châu", "Sơn La", "Hà Nam", "Nam Định", "Ninh Bình", "Thái Bình"],
            'Central': ["Thanh Hóa", "Nghệ An", "Hà Tĩnh", "Quảng Bình", "Quảng Trị", "Thừa Thiên Huế", "Đà Nẵng", "Quảng Nam", "Quảng Ngãi", "Bình Định", "Phú Yên", "Khánh Hòa", "Ninh Thuận", "Bình Thuận", "Kon Tum", "Gia Lai", "Đắk Lắk", "Đắk Nông", "Lâm Đồng"],
            'South': ["Hồ Chí Minh", "Bình Dương", "Đồng Nai", "Bình Phước", "Tây Ninh", "Bà Rịa - Vũng Tàu", "Long An", "Tiền Giang", "Bến Tre", "Trà Vinh", "Vĩnh Long", "Đồng Tháp", "An Giang", "Kiên Giang", "Cần Thơ", "Hậu Giang", "Sóc Trăng", "Bạc Liêu", "Cà Mau"]
        };

        function getRegion(provinceName) {
            if (!provinceName) return null;
            for (let region in VN_REGIONS) {
                if (VN_REGIONS[region].some(p => provinceName.includes(p) || p.includes(provinceName))) return region;
            }
            return null;
        }

        var startData = rawWaypoints[0];
        var endData = rawWaypoints[rawWaypoints.length - 1];
        var startRegion = startData ? getRegion(startData.province) : null;
        var endRegion = endData ? getRegion(endData.province) : null;
        var sameRegion = (startRegion && endRegion && startRegion === endRegion);
        var isShortCrossRegion = false;
        
        if (startRegion && endRegion && !sameRegion) {
            if ((startRegion === 'Central' && (endRegion === 'North' || endRegion === 'South')) ||
                (endRegion === 'Central' && (startRegion === 'North' || startRegion === 'South'))) {
                isShortCrossRegion = true;
            }
        }

        var finalWaypoints = [];
        var bounds = new maplibregl.LngLatBounds();

        for (var i = 0; i < rawWaypoints.length; i++) {
            var curr = rawWaypoints[i];
            if (isNaN(curr.lat) || isNaN(curr.lng) || curr.lat === 0) continue;
            
            finalWaypoints.push([curr.lng, curr.lat]);
            bounds.extend([curr.lng, curr.lat]);

            const marker = new maplibregl.Marker({ color: curr.color })
                .setLngLat([curr.lng, curr.lat])
                .setPopup(new maplibregl.Popup({ offset: 25 }).setHTML(`<b>${curr.type === 'start' ? 'Bắt đầu' : curr.type === 'end' ? 'Kết thúc' : 'Trạm phụ'}</b>: ${curr.name}`))
                .addTo(map);
            markers.push(marker);

            if (i < rawWaypoints.length - 1 && !sameRegion) {
                var next = rawWaypoints[i+1];
                var latDiff = Math.abs(curr.lat - next.lat);
                var crossesWaist = (Math.min(curr.lat, next.lat) < 16.5 && Math.max(curr.lat, next.lat) > 19.5);
                
                if (latDiff > 2.5 || crossesWaist) { 
                    var minLat = Math.min(curr.lat, next.lat);
                    var maxLat = Math.max(curr.lat, next.lat);
                    var isNorthbound = (next.lat > curr.lat);
                    var applicablePoints = VN_CORRIDOR.filter(cp => cp.lat > minLat + 0.5 && cp.lat < maxLat - 0.5);
                    
                    if (isNorthbound) applicablePoints.sort((a,b) => a.lat - b.lat);
                    else applicablePoints.sort((a,b) => b.lat - a.lat);
                    
                    var maxAnchors = isShortCrossRegion ? 1 : 2;
                    if (applicablePoints.length > maxAnchors) {
                        if (maxAnchors === 1) applicablePoints = [applicablePoints[Math.floor(applicablePoints.length / 2)]];
                        else applicablePoints = [applicablePoints[0], applicablePoints[applicablePoints.length - 1]];
                    }
                    applicablePoints.forEach(cp => {
                        finalWaypoints.push([cp.lng, cp.lat]);
                    });
                }
            }
        }

        if (finalWaypoints.length >= 2) {
            const coords = finalWaypoints.map(w => w[0] + ',' + w[1]).join(';');
            try {
                const response = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords}?overview=full&geometries=geojson`);
                const data = await response.json();

                if (data.code === 'Ok' && data.routes.length > 0) {
                    const route = data.routes[0];
                    map.addSource('route', {
                        'type': 'geojson',
                        'data': { 'type': 'Feature', 'properties': {}, 'geometry': route.geometry }
                    });
                    map.addLayer({
                        'id': 'route',
                        'type': 'line',
                        'source': 'route',
                        'layout': { 'line-join': 'round', 'line-cap': 'round' },
                        'paint': { 'line-color': '#0d6efd', 'line-width': 6, 'line-opacity': 0.8 }
                    });

                    lastTotalTimeSeconds = route.duration;
                    $('#totalDistance').text((route.distance / 1000).toFixed(1) + " km");
                    $('#totalTime').text((route.duration / 3600).toFixed(1) + " h");
                    $('#distanceInput').val((route.distance / 1000).toFixed(1));
                    calculateArrivalTime(route.duration);

                    // Simplified stop data calculation
                    let startTimeStr = $('#startTime').val();
                    let startTime = startTimeStr ? new Date(startTimeStr) : new Date();
                    let stopsData = [];
                    for (let i = 1; i < rawWaypoints.length - 1; i++) {
                        let ratio = i / (rawWaypoints.length - 1);
                        let estArrival = new Date(startTime.getTime() + (route.duration * ratio) * 1000);
                        stopsData.push({
                            stationId: rawWaypoints[i].stationId,
                            distance: parseFloat(((route.distance / (rawWaypoints.length - 1)) / 1000).toFixed(2)),
                            estArrivalTime: estArrival.toISOString()
                        });
                    }
                    $('#hiddenStops').val(JSON.stringify(stopsData));
                }
            } catch (err) {
                console.error("Routing Error:", err);
                // Fallback line
                map.addSource('route-fallback', {
                    'type': 'geojson',
                    'data': { 'type': 'Feature', 'properties': {}, 'geometry': { 'type': 'LineString', 'coordinates': finalWaypoints } }
                });
                map.addLayer({
                    'id': 'route-fallback',
                    'type': 'line',
                    'source': 'route-fallback',
                    'layout': { 'line-join': 'round', 'line-cap': 'round' },
                    'paint': { 'line-color': '#0d6efd', 'line-width': 6, 'line-opacity': 0.6, 'line-dasharray': [2, 2] }
                });
            }
            map.fitBounds(bounds, { padding: 60 });
        }
    }

    function debounceUpdateRoute() {
        clearTimeout(routeDebounceTimer);
        routeDebounceTimer = setTimeout(updateRoute, 600);
    }

    function updateRoute() {
        var start = $('#fromStation option:selected');
        var sLat = start.data('lat');
        var sLng = start.data('lng');
        var startData = start.val() ? { type: 'start', stationId: parseInt(start.val()), lat: parseFloat(sLat), lng: parseFloat(sLng), name: start.text(), color: '#0d6efd' } : null;

        var end = $('#toStation option:selected');
        var eLat = end.data('lat');
        var eLng = end.data('lng');
        var endData = end.val() ? { type: 'end', stationId: parseInt(end.val()), lat: parseFloat(eLat), lng: parseFloat(eLng), name: end.text(), color: '#dc3545' } : null;

        var intermediateStops = [];
        $('.intermediate-station').each(function () {
            var opt = $(this).find('.intermediate-select option:selected');
            if (opt.val()) {
                intermediateStops.push({ type: 'stop', stationId: parseInt(opt.val()), lat: parseFloat(opt.data('lat')), lng: parseFloat(opt.data('lng')), name: opt.text(), color: '#ffc107' });
            }
        });

        if (!startData || !endData) return;

        var rawWaypoints = [];
        rawWaypoints.push(startData);
        intermediateStops.forEach(s => rawWaypoints.push(s));
        rawWaypoints.push(endData);

        drawRoute(rawWaypoints);
    }

    function initSelect2() {
        $('.select2-bootstrap').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Chọn --', allowClear: true });
        $('.select2-stations').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Tìm trạm... --', allowClear: true });
        $('.intermediate-select').select2({ theme: 'bootstrap-5', width: '100%', placeholder: '-- Chọn trạm phụ --', allowClear: true });
    }

    async function filterStations(type) {
        var pId = (type === 'start') ? $('#provinceStart').val() : $('#provinceEnd').val();
        var targetSelect = (type === 'start') ? $('#fromStation') : $('#toStation');
        if (!pId) return;
        const response = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
        const stations = await response.json();
        let html = '<option value="">-- Chọn trạm --</option>';
        stations.forEach(s => { html += `<option value="${s.id}" data-lat="${s.lat}" data-lng="${s.lng}">${s.name}</option>`; });
        targetSelect.prop('disabled', false).html(html).trigger('change.select2');
    }

    function calculateArrivalTime(seconds) {
        var start = $('#startTime').val();
        if (!start || !seconds) return;
        var arrival = new Date(new Date(start).getTime() + seconds * 1000);
        $('#arrivalTime').val(arrival.toISOString().slice(0, 16));
    }

    function validateAndSubmit() {
        if (isRoutingInProgress) {
            console.warn("Routing chưa xong → vẫn submit");
        }
        
        // Ensure hidden stops are up to date
        var currentJson = $('#hiddenStops').val();
        if (!currentJson || currentJson === "" || currentJson === "[]") {
            var selectedStops = [];
            $('.intermediate-select').each(function() { 
                var val = $(this).val();
                if (val) selectedStops.push({ stationId: parseInt(val) }); 
            });
            $('#hiddenStops').val(JSON.stringify(selectedStops));
        }

        var form = document.getElementById('tripForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return false;
        }
        
        var submitBtn = $('button[type="submit"]');
        submitBtn.html('<span class="spinner-border spinner-border-sm align-middle me-2"></span><span class="align-middle">ĐANG CẬP NHẬT...</span>');
        setTimeout(() => { submitBtn.prop('disabled', true); }, 50);
        
        return true; 
    }
    
    const provinceOptionsHtml = `@Html.Raw(string.Join("", ((List<Province>)ViewBag.Provinces).Select(p => $"<option value='{p.ProvinceId}'>{p.ProvinceName}</option>")))`;

    var stopCounterGlobal = @(stopCounter);
    function addStop() {
        var id = stopCounterGlobal++;
        var html = `<div class="intermediate-station d-flex gap-2 align-items-center" id="stopRow_${id}">
            <div style="flex: 1;"><select class="form-select select2-bootstrap province-stop" onchange="loadStopStations(${id})">
                <option value="">-- Chọn Tỉnh --</option>
                ${provinceOptionsHtml}
            </select></div>
            <div style="flex: 1;"><select class="form-select select2-stations intermediate-select" onchange="debounceUpdateRoute()" disabled><option value="">-- Trạm phụ --</option></select></div>
            <button type="button" class="btn btn-link text-danger p-0" onclick="removeStop(${id})"><i class="bi bi-trash fs-5"></i></button>
        </div>`;
        $('#stopsList').append(html);
        initSelect2();
    }
    async function syncMapWithProvince(pId, type) {
        if (!pId) return;
        try {
            const response = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
            const stations = await response.json();
            showProvinceMarkers(stations, type);
        } catch (e) { console.error("Sync Map Error:", e); }
    }

    function showProvinceMarkers(stations, type) {
        markers.forEach(m => m.remove());
        markers = [];
        var bounds = new maplibregl.LngLatBounds();
        stations.forEach(s => {
            if (s.lat && s.lng) {
                bounds.extend([s.lng, s.lat]);
                var color = (type === 'start') ? '#0d6efd' : (type === 'end') ? '#dc3545' : '#ffc107';
                
                var marker = new maplibregl.Marker({ color: color })
                    .setLngLat([s.lng, s.lat])
                    .setPopup(new maplibregl.Popup({ offset: 25 }).setHTML(`
                        <div class="text-center p-1">
                            <h6 class="fw-bold mb-1 text-primary">${s.name}</h6>
                            <p class="small text-muted mb-2">${s.address}<br/>
                                <span class="badge bg-light text-dark border fw-normal">${s.wardName ? s.wardName + ', ' : ''}${s.districtName ? s.districtName + ', ' : ''}${s.province}</span>
                            </p>
                            <button type='button' class='btn btn-sm btn-primary w-100 rounded-pill fw-bold shadow-sm' onclick='selectFromMap(${s.id}, "${type}", "${s.name}")'>Chọn Trạm Này</button>
                        </div>
                    `))
                    .addTo(map);
                markers.push(marker);
            }
        });
        if (!bounds.isEmpty()) { map.fitBounds(bounds, { padding: 50 }); }
    }

    function selectFromMap(id, type, stationName) {
        var targetSelect;
        if (type === 'start') targetSelect = $('#fromStation');
        else if (type === 'end') targetSelect = $('#toStation');
        else if (type === 'stop') {
             targetSelect = $('.intermediate-select:not(:disabled)').last(); 
        }

        if (targetSelect) {
            targetSelect.val(id).trigger('change');
            map.closePopup();
            showToast(`Đã chọn trạm: ${stationName}`);
            var selectContainer = targetSelect.next('.select2-container');
            selectContainer.addClass('select-highlight');
            setTimeout(() => selectContainer.removeClass('select-highlight'), 1500);
            debounceUpdateRoute();
        }
    }

    function removeStop(id) { $(`#stopRow_${id}`).remove(); debounceUpdateRoute(); }

    async function loadStopStations(id) {
        var pId = $(`#stopRow_${id} .province-stop`).val();
        var target = $(`#stopRow_${id} .intermediate-select`);
        const res = await fetch(`/Driver/GetStationsByProvince?provinceId=${pId}`);
        const data = await res.json();
        let html = '<option value="">-- Chọn trạm --</option>';
        data.forEach(s => { html += `<option value="${s.id}" data-lat="${s.lat}" data-lng="${s.lng}">${s.name}</option>`; });
        target.prop('disabled', false).html(html).trigger('change.select2');
        showProvinceMarkers(data, 'stop');
    }

    function checkCapacity() {
        var vehicle = $('#vehicleSelect option:selected');
        var maxKg = vehicle.data('kg') || 0;

        var currKg = parseInt($('#capacityKgInput').val()) || 0;

        var isValid = true;
        if (currKg > maxKg) {
            isValid = false;
            $('#vehicleLimits').text(`Vượt quá tải trọng! (Tối đa ${maxKg}kg)`).removeClass('text-primary').addClass('text-danger');
        } else {
            $('#vehicleLimits').text(`Tối đa ${maxKg}kg`).removeClass('text-danger').addClass('text-primary');
        }
        return isValid;
    }
</script>
}